# Local development secrets (copy to .dev.vars). In production use: npx wrangler secret put NAME
# Recommended: protects the first-run setup page so nobody else can create the administrator.
SETUP_CODE=choose-a-long-random-code
# Optional alternatives (the setup page can store these for you):
# CHARGER_PASSWORD=
# RESEND_API_KEY=
# Legacy: creates the user "admin" with this password and skips the setup page.
# APP_PASSWORD=
